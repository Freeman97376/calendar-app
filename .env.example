# =============================================
# Calendar App — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# =============================================

# --- Firebase ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Frontend AI Assistant ---
# Active values: api, local. Legacy deepseek/anthropic/ollama values migrate to api.
VITE_AI_PROVIDER=api
VITE_AI_API_PROFILE=deepseek
VITE_AI_API_KEY=
VITE_AI_API_BASE_URL=https://api.deepseek.com
VITE_AI_API_MODEL=deepseek-chat
VITE_TIMEZONE_OVERRIDE=

# Legacy frontend DeepSeek fallback names are still read for compatibility.
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_MODEL=deepseek-chat

# --- Frontend input defaults ---
# VITE_DEFAULT_EVENT_COLOR=#047857
# VITE_DEFAULT_EVENT_START_TIME=09:00
# VITE_DEFAULT_EVENT_END_TIME=10:00
# VITE_DEFAULT_EVENT_TYPE_ID=general
# VITE_DEFAULT_TODO_EVENT_TYPE_ID=general
# VITE_DEFAULT_TODO_PRIORITY=medium

# --- DeepSeek backend AI ---
# Used by backend receipt/fridge analysis fallback. Do not expose this with a VITE_ prefix.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Fridge backend storage ---
# Optional. Defaults to backend/data.
FRIDGE_DATA_DIR=

# --- Fridge frontend API ---
VITE_FRIDGE_API_BASE_URL=http://127.0.0.1:8787
