# =============================================
# Calendar App — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# =============================================

# --- App mode and database ---
# Server mode requires MySQL 8.0+. Desktop mode chooses its own SQLite path.
CALENDAR_APP_MODE=desktop
CALENDAR_DATABASE_URL=
CALENDAR_COOKIE_SECURE=
# Production same-origin deployments should leave this empty. For separate Vite dev, list exact origins.
CALENDAR_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CALENDAR_LOG_LEVEL=info
# Request body limits are enforced before JSON or multipart parsing.
CALENDAR_LOGIN_MAX_REQUEST_BYTES=16384
CALENDAR_JSON_MAX_REQUEST_BYTES=1048576
CALENDAR_BACKUP_MAX_REQUEST_BYTES=26214400
CALENDAR_RECEIPT_MAX_FILE_BYTES=8388608
CALENDAR_MULTIPART_MAX_REQUEST_BYTES=10485760


# --- Frontend preferences (never put API keys here) ---
VITE_TIMEZONE_OVERRIDE=

# --- Frontend input defaults ---
# VITE_DEFAULT_EVENT_COLOR=#047857
# VITE_DEFAULT_EVENT_START_TIME=09:00
# VITE_DEFAULT_EVENT_END_TIME=10:00
# VITE_DEFAULT_EVENT_TYPE_ID=general
# VITE_DEFAULT_TODO_EVENT_TYPE_ID=general
# VITE_DEFAULT_TODO_PRIORITY=medium

# --- DeepSeek backend AI ---
# Used only by the backend AI proxy and fridge analysis. Do not expose with a VITE_ prefix.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Routine handles clarification and normal Check-ins; planning handles initial plans and replanning.
# If either is blank, DEEPSEEK_MODEL is used for that tier.
AI_ROUTINE_MODEL=deepseek-chat
AI_PLANNING_MODEL=deepseek-chat
# economy | balanced | quality. The maximum clamps the effective mode without erasing a saved choice.
AI_DEFAULT_USAGE_MODE=balanced
AI_MAX_USAGE_MODE=balanced
AI_MONTHLY_SOFT_LIMIT=1500000
AI_MONTHLY_HARD_LIMIT=2000000
AI_REQUESTS_PER_MINUTE=30
AI_MAX_REQUEST_BYTES=262144
# Login throttling is stored in the database. Forwarded addresses are trusted only from these peers.
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_IP_MAX_ATTEMPTS=30
AUTH_LOGIN_USERNAME_MAX_ATTEMPTS=10
AUTH_TRUSTED_PROXIES=

# --- Fridge backend storage ---
# Optional. Defaults to backend/data.
FRIDGE_DATA_DIR=

# Optional override only when the Vite proxy is not used. Production uses same-origin /api;
# Tauri injects its random sidecar URL.
VITE_API_BASE_URL=
