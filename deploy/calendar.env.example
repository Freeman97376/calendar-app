# Copy to /etc/calendar-app/calendar.env, owned by root with mode 0600.
# Service-manager environment file; do not commit the populated file or use VITE_* secrets.
CALENDAR_APP_MODE=server
CALENDAR_DATABASE_URL=mysql+pymysql://calendar_user:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:3306/calendar_app?charset=utf8mb4
CALENDAR_COOKIE_SECURE=true
CALENDAR_ALLOWED_ORIGINS=
CALENDAR_DATA_DIR=/var/lib/calendar-app
FRIDGE_DATA_DIR=/var/lib/calendar-app/fridge
AUTH_TRUSTED_PROXIES=127.0.0.1

# One reusable, non-expiring invitation code. Empty disables registration.
# Set a random code locally on the server; never put it in a URL or frontend build.
CALENDAR_REGISTRATION_INVITE_CODE=
AUTH_REGISTER_WINDOW_SECONDS=900
AUTH_REGISTER_IP_MAX_ATTEMPTS=10
AUTH_REGISTER_USERNAME_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_IP_MAX_ATTEMPTS=30
AUTH_LOGIN_USERNAME_MAX_ATTEMPTS=10

# Optional backend AI configuration. Blank key leaves AI unavailable.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_DEFAULT_USAGE_MODE=balanced
AI_MAX_USAGE_MODE=balanced
AI_MONTHLY_SOFT_LIMIT=1500000
AI_MONTHLY_HARD_LIMIT=2000000
AI_REQUESTS_PER_MINUTE=30

# Generate once, keep private, and back up together with the database. Never rotate without re-encrypting stored keys.
# A Fernet key from cryptography.fernet.Fernet.generate_key(); blank disables personal-key writes.
CALENDAR_AI_ENCRYPTION_KEY=
