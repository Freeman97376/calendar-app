[Unit]
Description=Calendar App API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=calendar-app
Group=calendar-app
WorkingDirectory=/opt/projects/calendar-app-current
EnvironmentFile=/etc/calendar-app/calendar.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/projects/calendar-app-current/.venv-server/bin/python -m uvicorn backend.server:create_app --factory --host 127.0.0.1 --port 18787 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
StateDirectory=calendar-app
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
